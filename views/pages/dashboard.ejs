<script src="/scripts/realm.js?v=32"></script>
<script>
    // --- GLOBAL API LOADING SPINNER INTERCEPTOR ---
    window.isBackgroundPolling = false;
    if (typeof window.apiCall === 'function') {
        const originalApiCall = window.apiCall;
        window.apiCall = async function(...args) {
            const isBg = window.isBackgroundPolling;
            const overlay = document.getElementById('loading-overlay');
            let spinnerTimeout;
            if (!isBg) spinnerTimeout = setTimeout(() => { if (overlay) overlay.style.display = 'flex'; }, 150);
            try {
                return await originalApiCall.apply(this, args);
            } finally {
                if (!isBg) clearTimeout(spinnerTimeout);
                if (overlay && !isBg) overlay.style.display = 'none';
            }
        };
    }

    // Keep older button names mapped to the new modal-driven handler in realm.js.
    async function openReputationModal(playerName) {
        if (typeof window.viewPlayerModerationDetails === 'function') {
            return window.viewPlayerModerationDetails(playerName, 'reputation');
        }
        if (typeof window.viewPlayerReputation === 'function') {
            return window.viewPlayerReputation(playerName);
        }
    }

    window.viewReputation = openReputationModal;
    window.viewPlayerReputation = openReputationModal;
    window.addEventListener('load', function() {
        window.viewReputation = openReputationModal;
        window.viewPlayerReputation = openReputationModal;
    });

    // --- TICKET SYSTEM FIX ---
    // Defines the openTicketModal function to ensure the popup opens correctly with Auth.
    
    async function openTicketModal(ticketId) {
        const modal = document.getElementById('ticket-modal');
        
        // Open modal immediately to give feedback
        modal.style.display = 'block';
        document.getElementById('modal-ticket-id').textContent = `Ticket #${ticketId}`;
        document.getElementById('modal-message').textContent = 'Loading details...';
        document.getElementById('modal-responses').innerHTML = '';
        document.getElementById('modal-player').textContent = '...';
        
        // IMPORTANT: Set this global ID so the 'Resolve' and 'Reply' buttons know which ticket to target
        window.currentTicketId = ticketId;

        try {
            // Use apiCall() instead of fetch() to ensure Auth Token is sent
            // Using /ticket/:id endpoint based on realm.js patterns
            const data = await apiCall(`/ticket/${ticketId}`);
            
            if (!data || data.error) throw new Error("Ticket data could not be loaded");

            // Populate Modal Fields
            document.getElementById('modal-player').textContent = data.player || 'Unknown';
            document.getElementById('modal-status').value = data.status || 'open';
            document.getElementById('modal-priority').value = data.priority || 'medium';
            document.getElementById('modal-category').value = data.category || 'other';
            document.getElementById('modal-assignee').value = data.assignee || '';
            document.getElementById('modal-message').textContent = data.message || 'No content provided.';
            
            // Show location if available
            if (data.location) {
                document.getElementById('modal-location-row').style.display = 'block';
                // Handle location object or string
                let locStr = typeof data.location === 'object' ? `${data.location.world} (${data.location.x}, ${data.location.y}, ${data.location.z})` : data.location;
                document.getElementById('modal-location').textContent = locStr;
            } else {
                document.getElementById('modal-location-row').style.display = 'none';
            }

            // Render Responses
            if (data.responses && data.responses.length) {
                document.getElementById('modal-responses').innerHTML = data.responses.map(r => `
                    <div style="margin-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 5px;">
                        <strong style="color: var(--accent-main);">${r.admin || r.author || 'Staff'}</strong>: 
                        <span style="color: #ccc;">${r.message}</span>
                        <div style="font-size: 0.7rem; color: #666;">${r.timestamp ? new Date(r.timestamp).toLocaleString() : ''}</div>
                    </div>
                `).join('');
            } else {
                document.getElementById('modal-responses').innerHTML = '<div style="color: #666; font-style: italic;">No responses yet.</div>';
            }

        } catch (e) {
            console.error("Ticket Load Error:", e);
            document.getElementById('modal-message').innerHTML = '<span style="color: #ef4444;">Could not load ticket details.</span><br><small>Error: ' + e.message + '</small>';
        }
    }

    // Assign globally to window.openTicketModal to override the one in realm.js
    window.openTicketModal = openTicketModal;
    
    window.addEventListener('load', function() {
        window.openTicketModal = openTicketModal;
    });
    
    // --- RESPONSIVE MOBILE LAYOUT LOGIC ---
    function toggleMobileSidebar(force) {
        const sidebar = document.querySelector('.sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        if (typeof force === 'boolean') {
            sidebar.classList.toggle('active-mobile', force);
            overlay.classList.toggle('active', force);
        } else {
            sidebar.classList.toggle('active-mobile');
            overlay.classList.toggle('active');
        }
    }

    // Auto-wrap tables for mobile horizontal scrolling and add aria-friendly labels to <td>
    function enhanceTableRowsForMobile() {
        document.querySelectorAll('.tab table').forEach(table => {
            const headers = Array.from(table.querySelectorAll('thead th')).map(th => th.textContent.trim());
            table.querySelectorAll('tbody tr').forEach(row => {
                row.querySelectorAll('td').forEach((cell, index) => {
                    if (headers[index]) cell.setAttribute('data-label', headers[index]);
                });
            });
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.tab table').forEach(table => {
            const wrapper = document.createElement('div');
            wrapper.className = 'table-wrapper';
            table.parentNode.insertBefore(wrapper, table);
            wrapper.appendChild(table);
        });

        enhanceTableRowsForMobile();

        // Observe table body mutations to keep data labels in sync for dynamically loaded rows
        const observer = new MutationObserver(mutations => {
            for (const mutation of mutations) {
                if (mutation.addedNodes.length || mutation.removedNodes.length) {
                    enhanceTableRowsForMobile();
                    break;
                }
            }
        });

        document.querySelectorAll('.tab table tbody').forEach(tbody => {
            observer.observe(tbody, { childList: true, subtree: true });
        });
    });

    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('nav-btn') || e.target.closest('.nav-btn')) {
            if (window.innerWidth <= 900) toggleMobileSidebar(false);
        }
    });

    // --- ANNOUNCEMENTS SYSTEM ---
    // Handles scheduling one-time announcements using the backend scheduler

    window.scheduleAnnouncement = async function() {
        const msgInput = document.getElementById('announce-msg');
        const timeInput = document.getElementById('announce-time');
        
        if (!msgInput.value || !timeInput.value) {
            alert("Please enter a message and select a date/time.");
            return;
        }

        try {
            // Use the one-time schedule endpoint
            const response = await apiCall('/announcements/schedule', 'POST', {
                message: msgInput.value,
                time: timeInput.value
            });

            if (response && (response.success || !response.error)) {
                alert("Announcement scheduled successfully!");
                msgInput.value = '';
                timeInput.value = '';
                loadAnnouncements();
            } else {
                throw new Error((response && response.error) || "Server returned error");
            }
        } catch (e) {
            console.error("Schedule Error:", e);
            alert("Failed to schedule: " + e.message);
        }
    };

    window.loadAnnouncements = async function() {
        const tbody = document.getElementById('announcements-table');
        if (!tbody) return;
        
        tbody.innerHTML = '<tr><td colspan="4">Loading...</td></tr>';
        
        try {
            const data = await apiCall('/announcements/scheduled');
            const list = data && data.announcements ? data.announcements : [];
            
            if (list.length > 0) {
                tbody.innerHTML = list.map((ann) => `
                    <tr>
                        <td>${ann.message}</td>
                        <td>${new Date(ann.time).toLocaleString()}</td>
                        <td>${ann.sent ? '<span style="color:#8b5cf6">Sent</span>' : '<span style="color:#3b82f6">Scheduled</span>'}</td>
                        <td><button onclick="deleteScheduledAnnouncement(${ann.index})" class="btn-danger action-btn">Delete</button></td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color: #888;">No announcements found.</td></tr>';
            }
        } catch(e) { 
            console.warn("Announcements fetch failed", e);
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color: #ef4444;">Failed to load announcements.</td></tr>';
        }
    };

    window.deleteScheduledAnnouncement = async function(index) {
         if(!confirm("Delete this scheduled announcement?")) return;
         
         try {
             const response = await apiCall('/announcements/schedule/' + index, 'DELETE');
             if (response && response.success) {
                 loadAnnouncements();
             } else {
                 throw new Error(response.error || "Unknown error");
             }
         } catch(e) {
             alert("Failed to delete: " + e.message);
         }
    };
    // Aliases for compatibility
    window.deleteAnnouncement = window.deleteScheduledAnnouncement;
    window.cancelAnnouncement = window.deleteScheduledAnnouncement;

    // --- MISSING SAVE FUNCTION ---
    // This was called by the HTML but missing in script
    window.saveAnnouncements = async function() {
        try {
            const interval = document.getElementById('announce-interval').value;
            const prefix = document.getElementById('announce-prefix').value;
            const messagesRaw = document.getElementById('announce-messages').value;
            const enabled = document.getElementById('announce-enabled').checked;

            const messages = messagesRaw.split('\n').filter(line => line.trim() !== '');

            await apiCall('/announcements', 'POST', {
                intervalMinutes: parseInt(interval),
                prefix: prefix,
                messages: messages,
                enabled: enabled
            });
            
            alert("Announcement settings saved!");
            document.getElementById('announce-status').textContent = "Settings saved successfully.";
            loadAnnouncements(); // Refresh the list
        } catch(e) {
            alert("Error saving: " + e.message);
        }
    };

    window.cancelAnnouncement = function(id) {
         window.deleteScheduledAnnouncement(id);
    };

    // Auto-load announcements when the tab is clicked
    document.addEventListener('click', function(e) {
        const target = e.target.closest('button');
        if (target && target.getAttribute('onclick')) {
             const onclick = target.getAttribute('onclick');
             if (onclick.includes("switchTab('announcements'")) setTimeout(window.loadAnnouncements, 200);
             if (onclick.includes("switchTab('scheduler'")) setTimeout(window.loadScheduledCommands, 200);
        }
    });
    
    // --- NATIVE PWA NOTIFICATIONS ---
    // Helper function to decode VAPID keys securely
    function urlBase64ToUint8Array(base64String) {
        const padding = '='.repeat((4 - base64String.length % 4) % 4);
        const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
        const rawData = window.atob(base64);
        const outputArray = new Uint8Array(rawData.length);
        for (let i = 0; i < rawData.length; ++i) { outputArray[i] = rawData.charCodeAt(i); }
        return outputArray;
    }

    window.requestPushPermissions = async function() {
        if (!("Notification" in window) || !("serviceWorker" in navigator) || !("PushManager" in window)) {
            alert("This browser does not support Advanced Web Push notifications.");
            return;
        }
        
        const permission = await Notification.requestPermission();
        if (permission !== "granted") {
            alert("Notification permission denied.");
            return;
        }

        try {
            const registration = await navigator.serviceWorker.ready;
            let subscription = await registration.pushManager.getSubscription();

            // Force a fresh subscription to ensure the server and browser are perfectly synced
            if (subscription) {
                await subscription.unsubscribe();
            }

            const response = await fetch('/push/public-key');
            if (!response.ok) throw new Error("Could not fetch VAPID key. Did you install web-push on the server?");
            const vapidPublicKey = await response.text();
            
            subscription = await registration.pushManager.subscribe({
                userVisibleOnly: true,
                applicationServerKey: urlBase64ToUint8Array(vapidPublicKey)
            });

            await fetch('/push/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(subscription)
            });
            
            alert("Advanced Web Push enabled! You will now receive alerts even when the app is closed.");
            updateNotificationBtnState();
            
            // Send test push from the server out to all registered devices
            await fetch('/push/notify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title: 'DrowsyCraft Alerts', body: 'Advanced Web Push successfully configured!' })
            });
        } catch (error) {
            console.error("Web Push Setup Error:", error);
            alert("Failed to subscribe: " + error.message);
        }
    }

    // Keeps backwards compatibility for local-only alerts if needed
    window.sendNotification = function(title, body) {
        if ("Notification" in window && Notification.permission === "granted") {
            new Notification(title, { body: body, icon: "/icons/icon-192x192.png" });
        }
    };

    function updateNotificationBtnState() {
        if ("Notification" in window && Notification.permission === "granted") {
            const btn = document.getElementById('btn-notifications');
            if (btn) {
                btn.textContent = "🔔 Alerts Enabled";
                btn.style.color = "#10b981"; // Success green
            }
                const btnOverview = document.getElementById('btn-notifications-overview');
                if (btnOverview) {
                    btnOverview.textContent = "✅ Alerts Enabled";
                    btnOverview.disabled = true;
                }
        }
    }

    // Register Service Worker for PWA
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW reg failed:', err));
            updateNotificationBtnState();
        });
    }
</script>
